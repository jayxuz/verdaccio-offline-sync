{
  "name": "verdaccio-offline-sync",
  "version": "1.3.0",
  "private": true,
  "description": "Verdaccio plugins for offline NPM dependency management",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "docker:build": "docker build -t jayxuz/verdaccio-offline-sync:${npm_package_version} -t jayxuz/verdaccio-offline-sync:latest .",
    "docker:push": "docker push jayxuz/verdaccio-offline-sync:${npm_package_version} && docker push jayxuz/verdaccio-offline-sync:latest",
    "docker:publish": "npm run docker:build && npm run docker:push",
    "test": "pnpm -r test",
    "test:repair-storage-manifests": "node --test scripts/repair-storage-manifests.test.mjs",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": "https://github.com/jayxuz/verdaccio-offline-sync",
  "author": "jayxuz",
  "homepage": "https://github.com/jayxuz/verdaccio-offline-sync"
}
